# Copy to .env and fill in when the ESP32 + HiveMQ + Supabase backend is
# ready. The dashboard checks the MQTT/WebSocket vars in this priority
# order: MQTT > WebSocket > mock. Supabase is checked independently for
# auth + historical data (falls back to mock/no-auth if unset).

# --- Supabase (auth + persistence backend) ---
# Project Settings > API in your Supabase project dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- HiveMQ / MQTT-over-WebSocket (primary path for this project) ---
# HiveMQ Cloud free cluster URL looks like:
#   wss://<your-cluster-id>.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_WS_URL=
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
# The current ESP32 firmware (Wokwi sketch) publishes everything to a
# single flat topic, not a per-node one - match it exactly here:
VITE_MQTT_TOPIC=aether/sensors
# Since that topic has no per-node segment, tell the dashboard which node
# card this single device's readings should update:
VITE_MQTT_DEFAULT_NODE_ID=node-01

# --- Plain WebSocket (only used if VITE_MQTT_WS_URL is unset) ---
VITE_WEBSOCKET_URL=

# --- REST / ThingSpeak (only needed if you also add REST fetch calls) ---
VITE_API_BASE_URL=
VITE_THINGSPEAK_CHANNEL_ID=
VITE_THINGSPEAK_READ_API_KEY=
